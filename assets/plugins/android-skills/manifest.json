{
  "schemaVersion": 1,
  "id": "android-skills",
  "name": "Android CLI & Official Skills",
  "description": "Built-in Google Android CLI with bundled JRE and 33 official Android Skills, placed at /attachments/skills/android-skills for Agent auto-discovery.",
  "version": "1.0.0",
  "latestVersion": "1.0.0",
  "enabled": true,
  "publisher": "TaiXu",
  "category": "DEVELOPER",
  "launchType": "command",
  "architectures": [
    "ARM64"
  ],
  "permissions": [
    "NETWORK",
    "WORKSPACE_READ",
    "WORKSPACE_WRITE"
  ],
  "updateStrategy": "REINSTALL",
  "source": "LOCAL",
  "offlineOnly": true,
  "installMethod": "LOCAL_PACKAGE",
  "installSteps": [
    "/bin/sh \"$TAIXU_PLUGIN_PAYLOAD/scripts/install-android-skills.sh\""
  ],
  "uninstallSteps": [
    "/bin/sh \"$TAIXU_PLUGIN_PAYLOAD/scripts/uninstall-android-skills.sh\""
  ],
  "verifyCommand": "/bin/sh \"$TAIXU_PLUGIN_PAYLOAD/scripts/verify-android-skills.sh\"",
  "launchCommand": "android info",
  "commandLinks": [
    "android"
  ]
}
